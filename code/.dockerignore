# Docker build context exclusions for ip-pinger.
# Keep local build artifacts and host dependencies out of the context so
# COPY . . cannot overwrite the dependency tree that npm ci installs inside
# the builder stage (native/platform-specific modules must be built on the
# target platform, not copied from the host).

# Source-control metadata
.git
.gitignore
.github

# IDE / editor
.vscode

# Dependencies (host copy must never enter the image)
node_modules
**/node_modules

# Compiled output (rebuilt by the builder stage)
dist
**/dist

# Test coverage output
coverage
.nyc_output

# Logs and build artifacts
*.log
*.tgz
*.tsbuildinfo

# Local environment files
.env
.env.*
