# ip-pinger — local Docker Compose environment variables (template).
#
# Copy this file to a local `.env` (git-ignored) and fill in values:
#   cp .env.example .env
#
# Only variables referenced by code/docker-compose.yml belong here.
# CONFIG_PATH is set directly in the Compose file, not read from `.env`.
#
# Both secrets share one rule: a value is valid when it is at least 32
# characters made up only of A-Z, a-z, and 0-9. `openssl rand -hex 32`
# satisfies it; a base64 value carrying +, /, or = does not.
#
# Neither secret can fail the boot. Unset, empty, or set-but-invalid
# disables the corresponding ability with a startup warning and the service
# boots normally; only a valid value enables it. A request header can never
# enable either — only a valid configured secret does. Never log a secret.

# Optional bearer secret for POST /restart-service (Authorization: Bearer).
#   - Unset / empty / set-but-invalid  = endpoint disabled (503); service boots.
#   - Valid (≥ 32 alphanumeric)        = endpoint enabled.
#   - Generate a strong value with:    openssl rand -hex 32
RESTART_SERVICE_TOKEN=

# Optional secret gating the configuration API (x-config-token header):
# GET /read-config, POST /write-config, GET /reload-config.
#   - Unset / empty / set-but-invalid  = API disabled (503); service boots.
#   - Valid (≥ 32 alphanumeric)        = API enabled (401 without a valid header).
#   - Generate a strong value with:    openssl rand -hex 32
IP_PINGER_CONFIG_TOKEN=

# Note: never commit the real `.env`; values may alternatively be supplied
# via the deployment environment directly.
